#!/usr/bin/env python3
"""Build an importable Alfred workflow from an explicit, credential-free file list."""

from pathlib import Path
import plistlib
import sys
from zipfile import ZIP_DEFLATED, ZipFile, ZipInfo

ROOT = Path(__file__).resolve().parent
FILES = ("info.plist", "icon.png", "workflow.sh", "filter.py", "command.py",
         "common.py", "keychain.py", "updater.py", "runtime.py", "README.md", "LICENSE", "version",
         "workflow/__init__.py", "workflow/workflow.py", "workflow/util.py",
         "workflow/web.py", "workflow/update.py", "workflow/background.py",
         "workflow/version", "workflow/LICENSE")


def build(destination=None, mobile=False):
    info = plistlib.loads((ROOT / "info.plist").read_bytes())
    version = (ROOT / "version").read_text().strip()
    if info["version"] != version:
        raise ValueError("info.plist and version must agree")
    files = FILES
    if mobile:
        version = (ROOT / "mobile-version").read_text().strip()
        info.update(bundleid="com.schwark.aqara.mobile", name="Aqara Mobile (Experimental)", version=version,
                    description="Parallel mobile API connection with Agent fallback",
                    readme=(ROOT / "docs/mobile-workflow.md").read_text())
        info["variables"].update(keyword="aqm", AQARA_BACKEND="mobile")
        for config in info["userconfigurationconfig"]:
            if config["variable"] == "keyword":
                config["config"].update(default="aqm", placeholder="aqm")
        for obj in info["objects"]:
            if obj["type"] == "alfred.workflow.input.scriptfilter":
                obj["config"]["title"] = "Aqara Mobile"
            if obj["type"] == "alfred.workflow.output.notification":
                obj["config"]["title"] = "Aqara Mobile"
        files += ("mobile_transport.py", "mobile_backend.py", "cloud_capabilities.py")
    prefix = "Aqara-Mobile-" if mobile else "Aqara-"
    output = Path(destination) if destination else ROOT / "dist" / (prefix + version + ".alfredworkflow")
    output.parent.mkdir(parents=True, exist_ok=True)
    with ZipFile(output, "w", compression=ZIP_DEFLATED) as archive:
        for filename in files:
            entry = ZipInfo(filename, date_time=(2026, 1, 1, 0, 0, 0))
            entry.compress_type = ZIP_DEFLATED
            entry.external_attr = (0o100755 if filename == "workflow.sh" else 0o100644) << 16
            content = (plistlib.dumps(info) if filename == "info.plist" else
                       (version + "\n").encode() if filename == "version" else
                       (ROOT / "docs/mobile-workflow.md").read_bytes() if mobile and filename == "README.md" else
                       (ROOT / filename).read_bytes())
            archive.writestr(entry, content)
    return output


if __name__ == "__main__":
    arguments = sys.argv[1:]
    mobile = "--mobile" in arguments
    arguments = [value for value in arguments if value != "--mobile"]
    print(build(arguments[0] if arguments else None, mobile=mobile))
