#!/usr/bin/env python3
"""Build an importable Alfred workflow from an explicit, credential-free file list."""

from pathlib import Path
import plistlib
import sys
from zipfile import ZIP_DEFLATED, ZipFile, ZipInfo

ROOT = Path(__file__).resolve().parent
FILES = ("info.plist", "icon.png", "workflow.sh", "filter.py", "command.py",
         "common.py", "keychain.py", "updater.py", "runtime.py", "README.md", "README-cloud.md", "LICENSE", "version",
         "cloud_transport.py", "cloud_backend.py", "cloud_capabilities.py",
         "cloud_identity.py", "cloud-identity.LICENSE",
         "workflow/__init__.py", "workflow/workflow.py", "workflow/util.py",
         "workflow/web.py", "workflow/update.py", "workflow/background.py",
         "workflow/version", "workflow/LICENSE")


def build(destination=None):
    info = plistlib.loads((ROOT / "info.plist").read_bytes())
    version = (ROOT / "version").read_text().strip()
    if info["version"] != version:
        raise ValueError("info.plist and version must agree")
    info["readme"] = (ROOT / "README.md").read_text() + "\n\n" + (ROOT / "README-cloud.md").read_text()
    output = Path(destination) if destination else ROOT / "dist" / ("Aqara-" + version + ".alfredworkflow")
    output.parent.mkdir(parents=True, exist_ok=True)
    with ZipFile(output, "w", compression=ZIP_DEFLATED) as archive:
        for filename in FILES:
            entry = ZipInfo(filename, date_time=(2026, 1, 1, 0, 0, 0))
            entry.compress_type = ZIP_DEFLATED
            entry.external_attr = (0o100755 if filename == "workflow.sh" else 0o100644) << 16
            content = (plistlib.dumps(info) if filename == "info.plist" else
                       (version + "\n").encode() if filename == "version" else
                       (ROOT / filename).read_bytes())
            archive.writestr(entry, content)
    return output


if __name__ == "__main__":
    if len(sys.argv) > 2 or any(value.startswith("--") for value in sys.argv[1:]):
        sys.exit("Usage: python3 workflow-build [output.alfredworkflow] — one package includes Agent and Cloud modes")
    print(build(sys.argv[1] if len(sys.argv) > 1 else None))
